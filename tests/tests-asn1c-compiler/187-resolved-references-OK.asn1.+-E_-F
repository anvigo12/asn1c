ModuleResolvedReferences { iso org(3) dod(6) internet(1) private(4)
	enterprise(1) spelio(9363) software(1) asn1c(5) test(1) 187 }
DEFINITIONS AUTOMATIC TAGS ::=
BEGIN

Common ::= SEQUENCE {
    stationId	 [0] IMPLICIT INTEGER,
    kind	 [1] IMPLICIT Kind
}

Kind ::= INTEGER {
    car(1),
    bus(2)
} (0..255)

Vehicle ::= SEQUENCE {
    stationId	 [0] IMPLICIT INTEGER,
    kind	 [1] IMPLICIT Kind,
    speed	 [2] IMPLICIT INTEGER,
    ...
}

Base ::= SEQUENCE {
    type	 [0] IMPLICIT Kind,
    plate	 [1] IMPLICIT IA5String OPTIONAL,
    extra	 [2] IMPLICIT NULL OPTIONAL
}

Car ::= Base (WITH COMPONENTS { ..., type (car), plate PRESENT })

Bus ::= Base (WITH COMPONENTS { ..., type (bus), extra ABSENT })

Road ::= Base ((WITH COMPONENTS { ..., type (car), plate PRESENT }) | (WITH COMPONENTS { ..., type (bus), extra ABSENT }))

Wrapped{Content} ::= SEQUENCE {
    data	 OCTET STRING (CONTAINING  Content)
}

WrappedCar ::= Wrapped{ Car}

CONTAINER ::= CLASS {
    &id	 Kind UNIQUE,
    &Type	 ANY
} WITH SYNTAX { &Type IDENTIFIED BY &id }


carId Kind ::= 1

busId Kind ::= 2

Containers CONTAINER ::= {{Car IDENTIFIED BY carId} | {Bus IDENTIFIED BY busId}}

Message ::= SEQUENCE {
    id	 [0] IMPLICIT CONTAINER.&id ({Containers}),
    body	 [1] EXPLICIT CHOICE {
        value	 [0] EXPLICIT CONTAINER.&Type ({Containers}{@.id}),    
        none	 [1] IMPLICIT NULL
    },
    copy	 [2] EXPLICIT CONTAINER.&Type ({Containers}{@id})
}

END
