	size_t constraining_column = 0; /* &id */
	size_t for_column = 1; /* &Content */
	size_t row, presence_index = 0;
	const INTEGER_t *constraining_value = (const INTEGER_t *)((const char *)parent_sptr + offsetof(struct Extension, id));
	
